{
  "manifest_version": 3,
  "name": "Pomodoro Study Tracker",
  "version": "1.0.0",
  "description": "Study with the Pomodoro technique and track how much you study each day.",
  "permissions": ["storage", "alarms", "notifications"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Pomodoro Study Tracker" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
